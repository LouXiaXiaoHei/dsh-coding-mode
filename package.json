{
  "name": "dsh-coding-mode",
  "version": "1.2.0",
  "description": "编程模式（coding preset）：像高级软件工程师一样思考，过程全程可见 —— 每次工具调用前先说明、改完一个文件立刻列出改动，并按场景主动加载调试/验证/评审技能。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./preflight": "./lib/preflight.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node --test scripts/preflight.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/LouXiaXiaoHei/dsh-coding-mode.git"
  },
  "bugs": {
    "url": "https://github.com/LouXiaXiaoHei/dsh-coding-mode/issues"
  },
  "homepage": "https://github.com/LouXiaXiaoHei/dsh-coding-mode#readme",
  "peerDependencies": {
    "superpowers-dsh": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "superpowers-dsh": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "preset",
    "coding",
    "编程模式"
  ]
}
